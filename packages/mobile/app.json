{
  "expo": {
    "name": "PrevCore",
    "slug": "prevcore",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "prevcore",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.prevcore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#08111f"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.prevcore.app",
      "supportsTablet": true
    },
    "extra": {
      "apiUrl": "https://svd3yfy099h6laqq1qg2g-preview-4200.runable.site/",
      "applicationId": "svd3yfy099h6laqq1qg2g"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#08111f"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
